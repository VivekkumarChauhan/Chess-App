<svg viewBox="0 0 240 40" xmlns="http://www.w3.org/2000/svg">
  <!-- White Pieces -->
  <g transform="translate(0,0)">
    <!-- Pawn -->
    <g transform="translate(0,0)">
      <circle cx="20" cy="28" r="8" fill="white" stroke="black" stroke-width="1" />
      <circle cx="20" cy="12" r="6" fill="white" stroke="black" stroke-width="1" />
      <line x1="20" y1="18" x2="20" y2="28" stroke="black" stroke-width="1" />
    </g>
    
    <!-- Knight -->
    <g transform="translate(40,0)">
      <circle cx="20" cy="28" r="8" fill="white" stroke="black" stroke-width="1" />
      <path d="M15,12 Q18,5 25,10 Q25,15 22,18 L20,28" fill="white" stroke="black" stroke-width="1" />
      <circle cx="23" cy="10" r="1" fill="black" />
    </g>
    
    <!-- Bishop -->
    <g transform="translate(80,0)">
      <circle cx="20" cy="28" r="8" fill="white" stroke="black" stroke-width="1" />
      <path d="M20,28 L16,18 L20,8 L24,18 L20,28" fill="white" stroke="black" stroke-width="1" />
      <circle cx="20" cy="8" r="3" fill="white" stroke="black" stroke-width="1" />
      <line x1="18" y1="15" x2="22" y2="15" stroke="black" stroke-width="1" />
    </g>
    
    <!-- Rook -->
    <g transform="translate(120,0)">
      <circle cx="20" cy="28" r="8" fill="white" stroke="black" stroke-width="1" />
      <rect x="15" y="10" width="10" height="18" fill="white" stroke="black" stroke-width="1" />
      <path d="M15,10 L15,6 L17,6 L17,8 L19,8 L19,6 L21,6 L21,8 L23,8 L23,6 L25,6 L25,10 Z" fill="white" stroke="black" stroke-width="1" />
    </g>
    
    <!-- Queen -->
    <g transform="translate(160,0)">
      <circle cx="20" cy="28" r="8" fill="white" stroke="black" stroke-width="1" />
      <path d="M20,28 L15,13 L13,8 L20,10 L27,8 L25,13 L20,28" fill="white" stroke="black" stroke-width="1" />
      <circle cx="13" cy="8" r="2" fill="white" stroke="black" stroke-width="1" />
      <circle cx="20" cy="5" r="2" fill="white" stroke="black" stroke-width="1" />
      <circle cx="27" cy="8" r="2" fill="white" stroke="black" stroke-width="1" />
    </g>
    
    <!-- King -->
    <g transform="translate(200,0)">
      <circle cx="20" cy="28" r="8" fill="white" stroke="black" stroke-width="1" />
      <path d="M20,28 L17,15 L23,15 L20,28" fill="white" stroke="black" stroke-width="1" />
      <rect x="17" y="10" width="6" height="5" fill="white" stroke="black" stroke-width="1" />
      <path d="M18,10 L18,5 L22,5 L22,10 M20,3 L20,7" stroke="black" stroke-width="1" fill="none" />
    </g>
  </g>
</svg>